{
  "name": "ztv-desktop",
  "productName": "ZTV",
  "version": "2.5.0",
  "description": "ZTV desktop shell (Windows / Ubuntu / macOS) wrapping the react-native-web build",
  "homepage": "https://github.com/zqryv/ZTV",
  "author": {
    "name": "ZTV",
    "email": "ztv@example.com"
  },
  "main": "main.js",
  "private": true,
  "scripts": {
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac --universal"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.ztv.player",
    "productName": "ZTV",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "web-build/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ZTV-v${version}-windows-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Video",
      "artifactName": "ZTV-v${version}-${os}-${arch}.${ext}"
    },
    "deb": {
      "depends": [],
      "maintainer": "ZTV <ztv@example.com>"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.video",
      "artifactName": "ZTV-v${version}-macos-universal.${ext}",
      "identity": "-"
    },
    "dmg": {
      "title": "ZTV ${version}",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    }
  }
}
